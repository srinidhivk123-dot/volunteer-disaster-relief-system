# ReliefConnect Backend Configuration Example
# Copy to .env and configure with your environment values

# Database Connection
# Local Development: sqlite:///./test.db or mysql+pymysql://root:password@localhost:3306/volunteer_disaster_relief
# Aiven Cloud MySQL: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=sqlite:///./test.db

# Optional SSL Certificate path for Aiven MySQL if required
# SSL_CA_PATH=/etc/secrets/ca.pem

# Security / JWT Configuration
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://volunteer-disaster-relief-system-fr-xi.vercel.app,https://volunteer-disaster-relief-system.vercel.app
